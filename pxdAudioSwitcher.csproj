<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>pxdAudioSwitcher</RootNamespace>
    <AssemblyName>pxdAudioSwitcher</AssemblyName>
    <Version>1.4.0</Version>
    <Product>pxd Audio Switcher</Product>
    <Company>pxd</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\pxdAudioSwitcher.ico')">Assets\pxdAudioSwitcher.ico</ApplicationIcon>
    <!-- Keep memory low: no background GC thread, no profile-guided tiering, no ICU culture data. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <!-- Self-test only: draws the windows with no OS window at all -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <!-- Native graphics libs ship large debug symbols; keep the install lean. -->
  <Target Name="TrimPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PruneFiles Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PruneFiles)" />
  </Target>

</Project>
