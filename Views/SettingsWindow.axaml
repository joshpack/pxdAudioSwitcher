<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="pxdAudioSwitcher.Views.SettingsWindow"
        Title="pxd Audio Switcher"
        Width="560" Height="740" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <!-- The pxd title bar (icon, name, the hotkey status and the caption buttons) is added in code: pxdChrome.Wrap -->
  <Grid Margin="22,10,22,16">

    <TabControl x:Name="Tabs" Padding="0,10,0,0">

      <TabItem Header="Devices">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,0,12,6">

            <Border x:Name="ConflictCard" Classes="card" IsVisible="False" Background="#2A2210" BorderBrush="#7A5A1A" Padding="14">
              <TextBlock x:Name="ConflictText" TextWrapping="Wrap" Foreground="#F5C97A" FontSize="12" />
            </Border>

            <Border Classes="card" Padding="16">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="PLAYBACK" Classes="label" />
                    <TextBlock Text="Hotkey moves to the next ticked device" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <ContentControl x:Name="PlaybackHotkeySlot" Grid.Column="1" />
                </Grid>
                <StackPanel x:Name="PlaybackList" Spacing="4" />
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="16">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="RECORDING" Classes="label" />
                    <TextBlock Text="Hotkey moves to the next ticked microphone" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <ContentControl x:Name="RecordingHotkeySlot" Grid.Column="1" />
                </Grid>
                <StackPanel x:Name="RecordingList" Spacing="4" />
                <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,4" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Mute microphone" />
                    <TextBlock x:Name="MuteState" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <Button x:Name="MuteButton" Grid.Column="1" MinHeight="34" Padding="12,4" />
                  <ContentControl x:Name="MuteHotkeySlot" Grid.Column="2" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="4,0"
                       Text="With nothing ticked, the hotkey goes through every device that is plugged in. Unplugged devices are skipped and remembered." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Profiles">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,0,12,6">
            <Border Classes="card" Padding="16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="A profile switches speakers and microphone together, from its own hotkey, the tray menu, or by itself when one of its programs comes to the front." />
                <Button x:Name="AddProfileButton" Grid.Column="1" Content="+  New profile" Classes="primary" />
              </Grid>
            </Border>
            <StackPanel x:Name="ProfileList" Spacing="12" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Settings">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,0,12,6">
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="After switching" />
                    <TextBlock Text="The sound plays on the new device" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <ComboBox x:Name="NotifyBox" Grid.Column="1" Width="190" MinHeight="34">
                    <ComboBoxItem Content="Show a banner" />
                    <ComboBoxItem Content="Banner and a sound" />
                    <ComboBoxItem Content="Play a sound" />
                    <ComboBoxItem Content="Nothing" />
                  </ComboBox>
                </Grid>
                <Grid x:Name="SpotRow" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="8" VerticalAlignment="Center">
                    <StackPanel Spacing="1">
                      <TextBlock Text="Banner position" />
                      <TextBlock Text="Click a spot on the screen; a preview shows there" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="ScreenBox" MinHeight="34" HorizontalAlignment="Left" Width="210">
                      <ComboBoxItem Content="Screen the mouse is on" />
                      <ComboBoxItem Content="Main screen" />
                    </ComboBox>
                  </StackPanel>
                  <!-- A little monitor: nine spots across its face -->
                  <StackPanel Grid.Column="1" Spacing="0" HorizontalAlignment="Center">
                    <Border Width="176" Height="104" CornerRadius="8" Padding="6" BorderThickness="2"
                            BorderBrush="#2B3242" Background="{StaticResource BgBrush}">
                      <UniformGrid x:Name="SpotGrid" Rows="3" Columns="3" />
                    </Border>
                    <Border Width="34" Height="8" Background="#2B3242" HorizontalAlignment="Center" />
                    <Border Width="70" Height="4" CornerRadius="2" Background="#2B3242" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Take apps with their own device along" />
                    <TextBlock Text="Apps set to a device in Windows' Volume mixer ignore the default. With this on, a switch clears their own device so they follow it" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch x:Name="MoveAppsSwitch" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Let every app follow the default" />
                    <TextBlock x:Name="ReleaseAllNote" Text="Clears the own output and input device of every app, including games that aren't running" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button x:Name="ReleaseAllButton" Grid.Column="1" Content="Reset all apps" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Switch the communications device too" />
                    <TextBlock Text="Turn off to keep calls (Discord, Teams…) on the same headset whatever you switch" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch x:Name="CommsSwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Start when I sign in" />
                    <TextBlock x:Name="AutostartNote" Text="Runs quietly in the tray" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch x:Name="AutostartSwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Start minimized to the tray" />
                    <TextBlock Text="Also when you open it yourself; click the tray icon for this window" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch x:Name="TrayStartSwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Show tray icon" />
                    <TextBlock Text="Also set from pxd Toolkit. Hidden, the hotkeys keep working; start the app again for this window" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch x:Name="TrayIconSwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Quit pxd Audio Switcher" />
                    <TextBlock Text="Closing this window keeps it running; this stops the hotkeys too" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button x:Name="QuitButton" Grid.Column="1" Content="Quit" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Text="COMMAND LINE" Classes="label" />
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="For desktop shortcuts, Stream Deck buttons and scripts. Works whether or not the app is running." />
                <TextBox x:Name="CliText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas,monospace" FontSize="12" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
